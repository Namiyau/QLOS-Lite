# Copy this file to secrets.local.env and fill local values.
# Never commit secrets.local.env.
QLOS_OWNER_QQ_ID=replace-with-owner-qq-id
QLOS_BOT_QQ_ID=replace-with-bot-qq-id
QLOS_ALLOWED_GROUP_IDS=replace-with-group-id
QLOS_HERMES_API_URL=http://127.0.0.1:8642/v1/chat/completions
QLOS_HERMES_API_KEY=replace-with-local-hermes-key
QLOS_ONEBOT_BASE_URL=http://127.0.0.1:3000
QLOS_ONEBOT_ACCESS_TOKEN=
QLOS_ONEBOT_INBOUND_TOKEN=replace-with-local-inbound-token
QLOS_HERMI_GATEWAY_URL=http://127.0.0.1:8789
QLOS_HERMI_GATEWAY_TOKEN=replace-with-local-hermi-token
QLOS_ROLES_FILE=./roles.json
QLOS_MEDIA_DIR=./state/media
QLOS_ENABLE_QUEUE=true
QLOS_QUEUE_DIR=./state/qlos_lite/queue
